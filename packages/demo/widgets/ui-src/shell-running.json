{"html":["<div class=\"chrome svelte-ike2n6\"><!----><!----> <!----><!----> <div class=\"run-row svelte-5w5jzo\"><span class=\"left svelte-5w5jzo\"><!----></span> <span class=\"right svelte-5w5jzo\"><!----> <button class=\"interrupt press focus-ring svelte-5w5jzo\" data-testid=\"interrupt\" title=\"Stop (Esc or \u2303C): stops everything this chat is doing, background work included\"><span class=\"stop svelte-5w5jzo\"></span> stop</button><!----></span></div> <!----> <div role=\"group\" class=\"composer svelte-5w5jzo\"><input type=\"file\" multiple=\"\" hidden=\"\" data-testid=\"file-picker\"> <button type=\"button\" class=\"attach press focus-ring svelte-5w5jzo\" aria-label=\"Attach files\" title=\"Attach files\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m21 11-9 9a6 6 0 0 1-8.5-8.5l9-9a4 4 0 0 1 5.7 5.7l-9 9a2 2 0 0 1-2.8-2.8L15 6\"></path></svg></button> <textarea rows=\"1\" data-testid=\"composer\" aria-label=\"Message\" class=\"svelte-5w5jzo\" placeholder=\"Correct it mid-run\u2026\" style=\"overflow-y: hidden; height: 42px;\"></textarea> <!----> <!----> <!----><!----> <button class=\"send press focus-ring svelte-5w5jzo\" data-testid=\"send\" aria-label=\"Send\" disabled=\"\">\u2191</button></div><!----></div>"],"css":[".interrupt.svelte-5w5jzo{display:flex;align-items:center;gap:6px;height:36px;padding:0 12px;flex:none;border:1px solid color-mix(in srgb,var(--warn) 45%,transparent);border-radius:18px;color:var(--warn);font-size:12.5px}",".stop.svelte-5w5jzo{width:8px;height:8px;background:var(--warn);border-radius:2px}","@media(max-width:860px){.interrupt.svelte-5w5jzo{background:var(--bg-raised);box-shadow:0 6px 18px #00000057}}"]}